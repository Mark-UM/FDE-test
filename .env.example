# Local development only. Copy to .env at the repository root.
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
POSTGRES_DB=order_support
POSTGRES_USER=order_support
# Replace both placeholders together; URL-encode special characters in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-local-password
# Compose uses postgres as the database hostname. For host-based development use localhost.
DATABASE_URL=postgresql+psycopg://order_support:replace-with-local-password@postgres:5432/order_support

# Independent DemoCommerce S0-S1 origin for host-based Product integration.
# From Docker Desktop containers, use http://host.docker.internal:9000 instead.
# S0-S1 does not implement API-key authentication.
SANDBOX_BASE_URL=http://127.0.0.1:9000
SANDBOX_TIMEOUT_SECONDS=5
